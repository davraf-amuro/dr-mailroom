# dr-mailroom — variabili d'ambiente del container. Copia in .env (ignorato da git) e sostituisci i placeholder.
# Il doppio underscore (__) corrisponde ai ":" delle sezioni di configurazione .NET.

# SQL Server: dal container "localhost" è il container stesso.
# Se SQL Server gira sulla macchina che ospita Docker usa host.docker.internal, altrimenti il nome o l'IP del server.
ConnectionStrings__MailroomDb=Server=CHISSADOVE;Database=CHISSAQUALE;User Id=CHISSACHI;Password=CHISSAQUALE;TrustServerCertificate=True

# Client OAuth Google (dal JSON scaricato dalla console)
Mailroom__Gmail__ClientId=CHISSAQUALE.apps.googleusercontent.com
Mailroom__Gmail__ClientSecret=CHISSAQUALE
Mailroom__Gmail__RedirectUri=http://localhost:5180/api/v1/mailboxes/connect/callback

# Chiave API richiesta nell'header x-api-key (generane una lunga e casuale)
Authentication__ApiKey__ApiKeyValue=CHISSAQUALE

# Frontend (CORS e redirect dopo il collegamento della casella)
Mailroom__Frontend__BaseUrl=http://localhost:5173
# Solo sviluppo: origini CORS in più (es. dev server Vite). Mai in produzione.
# Mailroom__Frontend__ExtraCorsOrigins__0=http://localhost:5173

# Facoltativi: cron Quartz (secondi inclusi) e parallelismo
# Mailroom__Schedule__Cron=0 0/15 * * * ?
# Mailroom__Processing__MaxParallelMailboxes=2
# Consumatori della coda di elaborazione per casella (Gmail si legge comunque una mail per volta)
# Mailroom__Processing__MaxParallelMessages=4
# Unità di quota Gmail al minuto per casella (limite Google: 15000)
# Mailroom__Gmail__QuotaUnitsPerMinute=12000

# Facoltativi: cartelle sull'host montate come volumi (default ./data/...)
# ATTACHMENTS_HOST_PATH=D:/Mailroom/allegati
# KEYS_HOST_PATH=./data/keys
# LOGS_HOST_PATH=./data/logs

# Facoltativo: fuso orario del container (default Europe/Rome) per log, file giornalieri e cron
# TZ=Europe/Rome
