{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug dr-mailroom-api (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/dr-mailroom-api/bin/Debug/net10.0/dr-mailroom-api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/dr-mailroom-api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5180"
      }
    },
    {
      "name": "Debug dr-mailroom-api (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/dr-mailroom-api/bin/Debug/net10.0/dr-mailroom-api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/dr-mailroom-api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7143;http://localhost:5180"
      }
    }
  ]
}
