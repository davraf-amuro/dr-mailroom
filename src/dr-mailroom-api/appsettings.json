{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MailroomDb": "data source=CHISSADOVE;initial catalog=CHISSAQUALE;user id=CHISSACHI;password=CHISSAQUALE;TrustServerCertificate=True"
  },
  "Mailroom": {
    "Schedule": {
      "Cron": "0 0/15 * * * ?"
    },
    "Retention": {
      "TrashedMessagesDays": 180,
      "PurgeCron": "0 30 3 * * ?"
    },
    "Processing": {
      "MaxParallelMailboxes": 2,
      "MaxParallelMessages": 4,
      "IncludeSpamTrash": false
    },
    "Filtering": {
      "RegexTimeoutMs": 250
    },
    "Attachments": {
      "RootPath": "data/attachments",
      "MaxSizeBytes": 26214400
    },
    "DataProtection": {
      "KeyRingPath": "data/keys"
    },
    "Gmail": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "http://localhost:5180/api/v1/mailboxes/connect/callback",
      "QuotaUnitsPerMinute": 12000
    },
    "Frontend": {
      "BaseUrl": "http://localhost:5173"
    }
  },
  "Authentication": {
    "ApiKey": {
      "SchemeName": "ApiKey",
      "HeaderName": "x-api-key",
      "ApiKeyValue": "",
      "UserName": "mailroom-client"
    }
  }
}
